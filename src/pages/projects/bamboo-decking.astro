		category: "Thermo-Treated Bamboo Decking",
		specs: "Class 1 durability rated thermal modification process resisting rot, mold, fungi, and insect attack without chemical leaching.",
		location: "Sports & Country Club",
	},
	{
		img: port8,
		title: "Open-Air Restaurant & Bar Platform",
		category: "Oil-Treated Dark Brown Decking",
		specs: "Weatherproof oil-finished bamboo boards easily cleanable and resistant to beverage stains and outdoor wear.",
		location: "Commercial Hospitality",
	},
	{
		img: port9,
		title: "Urban Riverside Eco-Trail Boardwalk",
