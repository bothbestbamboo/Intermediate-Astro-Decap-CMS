		specs: "Large-scale outdoor bamboo decking with fine-grooved anti-slip surface processing and integrated long bench seating for high-traffic viewing areas.",
		location: "Public Scenic Overlook",
	},
	{
		img: port3,
		title: "Cantilevered Mountain Overlook Balcony",
		category: "Structural Bamboo Posts & Guardrails",
		specs: "High-strength overhanging deck platform crafted with strand woven bamboo decking, posts, and protective safety handrails.",
		location: "Eco-Tourism & Mountain Trail",
	},
	{
		img: port4,
		title: "Scenic Bamboo Viewing Gazebo & Pavilion",
		category: "Bamboo Cladding & Slatted Pergola",
		specs: "Architectural pavilion constructed with outdoor bamboo wall cladding, slatted pergola ceiling, and matching bamboo balustrades.",
		location: "Park Pavilion Infrastructure",
	},
	{
		img: port5,
		title: "Luxury Villa Zen Courtyard Terrace",
		category: "Small Groove Strand Woven Decking",
		specs: "Precision-milled grooved bamboo flooring seamlessly integrated into a Japanese-inspired private courtyard and garden walkway.",
		location: "Residential Landscaping",
	},
	{
		img: port6,
