---
/**
 * * A simple banner used on every page except the homepage
 * * Takes a title, an optional subtitle, and an image as props
 */

// Utils
import { Picture } from "astro:assets";
import type { GetImageResult } from "astro";

interface Props {
	title: string; // heading text
	subtitle?: string; // 副标题文字（?表示可选）
	image: GetImageResult; // pre-optimized image from getImage()
}

const { title, subtitle, image } = Astro.props;
---

<section id="int-hero">
	<div class="hero-content">
		<h1 id="home-h">{title}</h1>

		{subtitle && <p>{subtitle}</p>}
	</div>

	<Picture
		src={image.src}
		width={image.attributes.width}
		height={image.attributes.height}
		formats={["avif", "webp"]}
		alt=""
		priority
	/>
</section>

<style lang="less">
	/*-- -------------------------- -->
<---   Interior Page Header     -->
<--- -------------------------- -*/

	/* Mobile & Default */
	@media only screen and (min-width: 0em) {
		#int-hero {
			/* 🌟 严格固定高度为 410px，防止被多行文字撑高 */
			height: 410px !important;
			max-height: 410px !important;
			width: 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			position: relative;
			z-index: 1;
			overflow: hidden;

			&:before {
				content: "";
				width: 100%;
				height: 100%;
				background: #000;
				/* 将遮罩不透明度保持在 0.4，让背景图更明亮 */
				opacity: 0.4;
				display: block;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -1;
			}

			.hero-content {
				width: 96%;
				max-width: (1100/16rem);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				z-index: 2;
			}

			picture {
				width: 100%;
				height: 100%;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -2;

				img {
					width: 100%;
					height: 100%;
					object-fit: cover;
					position: absolute;
					top: 0;
					left: 0;
				}
			}

			h1 {
				font-size: var(--headerFontSize);
				text-align: center;
				width: 100%;
				max-width: (950/16rem);
				margin: 0 auto;
				margin-bottom: (10/16rem);
				color: #fff;
				word-wrap: break-word;
				line-height: 1.25;
			}

			p {
				text-align: center;
				width: 100%;
				max-width: (850/16rem);
				margin: 0 auto;
				color: #fff;
				word-wrap: break-word;
				line-height: 1.5;
			}
		}
	}

	/* Small Desktop */
	@media only screen and (min-width: 64em) {
		#int-hero {
			height: 410px !important;
			max-height: 410px !important;
			background-attachment: fixed;

			p {
				max-width: (1100/16rem);
			}
		}
	}
</style>