// Banner Image
import landingImage from "@assets/images/gallery/bannerplywood.jpg";

// Project Showcase Images
import port1 from "@assets/images/projects/ply1.jpg";
import port2 from "@assets/images/projects/ply2.jpg";
import port3 from "@assets/images/projects/ply3.jpg";
import port4 from "@assets/images/projects/ply4.jpg";
import port5 from "@assets/images/projects/ply5.jpg";
import port6 from "@assets/images/projects/ply6.jpg";
import port7 from "@assets/images/projects/ply7.jpg";
import port8 from "@assets/images/projects/ply8.jpg";
import port9 from "@assets/images/projects/ply9.jpg";
import port10 from "@assets/images/projects/ply10.jpg";
import port11 from "@assets/images/projects/ply11.jpg";
