---
/**
 * * A simple banner used on every page except the homepage
 * * Takes a title, an optional subtitle, and an image as props
 */

// Utils
import { Picture } from "astro:assets";
import type { GetImageResult } from "astro";

interface Props {
	title: string; // heading text
	subtitle?: string; // 副标题文字（?表示可选）
	image: GetImageResult; // pre-optimized image from getImage()
}

const { title, subtitle, image } = Astro.props;
---

<section id="int-hero">
	<div class="hero-content">
		<h1 id="home-h">{title}</h1>

		{subtitle && <p>{subtitle}</p>}
	</div>

	<Picture
		src={image.src}
		width={image.attributes.width}
		height={image.attributes.height}
		formats={["avif", "webp"]}
		alt=""
		priority
	/>
</section>

<style lang="less">
	/*-- -------------------------- -->
<---   Interior Page Header     -->
<--- -------------------------- -*/

	/* Mobile & Default */
	@media only screen and (min-width: 0em) {
		#int-hero {
			/* 🌟 总高度设为 454px，扣除顶部 Header 压住的 88px 后，实际露出的图片高度刚好是 366px */
			height: 454px !important;
			max-height: 454px !important;
			width: 100%;
			/* 顶部加上 88px 偏移补偿，保证文字在下方 366px 的可见区域内垂直居中 */
			padding-top: 88px !important;
			padding-bottom: 0 !important;
			margin: 0 !important;
			display: flex;
			flex-direction: column;
			justify-content: center !important;
			align-items: center !important;
			position: relative;
			z-index: 1;
			overflow: hidden;
			box-sizing: border-box !important;

			&:before {
				content: "";
				width: 100%;
				height: 100%;
				background: #000;
				opacity: 0.4;
				display: block;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -1;
			}

			.hero-content {
				width: 96%;
				max-width: (1100/16rem);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				z-index: 2;
				padding: 0 !important;
				margin: auto !important;
			}

			picture {
				width: 100%;
				height: 100%;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -2;

				img {
					width: 100%;
					height: 100%;
					object-fit: cover;
					position: absolute;
					top: 0;
					left: 0;
				}
			}

			h1 {
				font-size: var(--headerFontSize);
				text-align: center;
				width: 100%;
				max-width: (950/16rem);
				margin: 0 auto !important;
				padding: 0 !important;
				color: #fff;
				word-wrap: break-word;
				line-height: 1.25;
			}

			p {
				text-align: center;
				width: 100%;
				max-width: (850/16rem);
				margin: (12/16rem) auto 0 auto !important;
				padding: 0 !important;
				color: #fff;
				word-wrap: break-word;
				line-height: 1.5;
			}
		}
	}

	/* Small Desktop */
	@media only screen and (min-width: 64em) {
		#int-hero {
			height: 454px !important;
			max-height: 454px !important;
			padding-top: 88px !important;
			background-attachment: fixed;

			p {
				max-width: (1100/16rem);
			}
		}
	}
</style>