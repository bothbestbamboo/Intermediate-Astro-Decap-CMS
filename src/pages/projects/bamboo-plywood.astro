	},
	{
		img: port2,
		title: "Multi-Zone Interior Bamboo Wall & Ceiling Cladding",
		category: "Custom Bamboo Beam & Wall Paneling",
		specs: "Comprehensive indoor bamboo cladding incorporating floor-to-ceiling slatted screens, tiered seating structures, and architectural ceiling baffles.",
		location: "Corporate Exhibition Lobby",
	},
	{
		img: port3,
		title: "Reception Desk & Feature Wall Slatted Integration",
		category: "Vertical Grain Bamboo Slat Systems",
		specs: "Custom-built reception counter with matching full-height bamboo slat backdrop, framing continuous green accent wall features.",
		location: "Corporate Reception Area",
	},
	{
		img: port4,
		title: "Architectural Display Wall & Ceiling Baffle System",
		category: "Linear Bamboo Ceiling & Wall Baffles",
		specs: "High-density natural bamboo linear baffles integrated with digital display screens and accent lighting for modern public spaces.",
		location: "Public Facility & Info Center",
	},
	{
		img: port5,
		title: "Vertical Bamboo Screen Partition Wall Detail",
		category: "Solid Bamboo Posts & Partition Slats",
		specs: "Custom vertical bamboo post partitions anchored with metallic hardware, providing semi-private space division with enhanced airflow.",
		location: "Commercial Interior Space",
	},
	{
		img: port6,
		title: "Lobby Interior with Bamboo Wall & Ceiling Panels",
		category: "Large-Format Bamboo Panels & Slats",
		specs: "Expansive commercial lobby feature combining seamless horizontal bamboo wall paneling, ceiling baffles, and vertical divider screens.",
		location: "Corporate Headquarters Lobby",
	},
	{
		img: port7,
		title: "Atrium Space Division & Open Screen Structure",
		category: "Full-Height Bamboo Post Partitions",
		specs: "Floor-to-ceiling slender bamboo posts creating a light-transmitting architectural screen across multi-level commercial interior zones.",
		location: "Architectural Atrium & Hall",
	},
	{
		img: port8,
		title: "Mezzanine Wall Cladding & Concealed Door Integration",
		category: "Multi-Layer Bamboo Wall Panels",
		specs: "Large-format bamboo veneer panels featuring seamless flush-mounted doors and complementary slatted balcony railing fascia.",
		location: "Commercial Mezzanine & Corridor",
	},
	{
		img: port9,
		title: "Custom Bamboo Millwork & Shelving Units",
		category: "Cross-Laminated Solid Bamboo Boards",
		specs: "Bespoke storage cabinetry and alcove display framing manufactured with multi-layer caramel bamboo boards showcasing exposed edge grain.",
		location: "Commercial & Healthcare Interior",
	},
	{
		img: port10,
		title: "Medical Examination Room Bamboo Fit-Out",
		category: "Eco-Friendly Bamboo Wall & Flooring",
		specs: "Low-VOC, hygienic bamboo flooring and upper wall frieze paneling designed for modern medical offices and specialized consultation rooms.",
		location: "Healthcare & Clinic Suite",
	},
	{
		img: port11,
		title: "Clinic Waiting Lounge & Entrance Fit-Out",
		category: "Integrated Bamboo Flooring & Trim Work",
		specs: "Cohesive healthcare reception design incorporating natural bamboo flooring, door architraves, skirting boards, and architectural wall friezes.",
		location: "Medical Reception & Lounge",
	},
	{
		img: port12,
		title: "Precision Edge Finishing & Cabinetry Joinery Detail",
		category: "3-Ply Solid Bamboo Panels",
		specs: "Close-up of structural bamboo cabinet framing and base skirting, featuring fine edge chamfering and seamless floor transition joinery.",
		location: "Architectural Joinery Detail",
	},
	{
		img: port13,
		title: "Linear Slatted Ceiling & Glass Partition Integration",
		category: "Architectural Slatted Bamboo Panels",
		specs: "Precision linear slatted bamboo ceiling system integrated with recessed LED lighting, wall paneling, and frameless glass partitions.",
		location: "Commercial Headquarters",
	},
	{
		img: port14,
		title: "Executive Gallery Walkway & Slatted Ceiling",
		category: "Multi-Layer Bamboo Paneling & Flooring",
		specs: "Continuous bamboo element integration combining linear slatted ceilings with natural bamboo wall paneling and matching hardwood flooring.",
		location: "Corporate Exhibition Hall",
	},
	{
		img: port15,
		title: "Main Entrance Lobby & Reception Cladding",
		category: "Large-Format Bamboo Wall Panels",
		specs: "Floor-to-ceiling multi-layer bamboo wall cladding framing architectural portals, elevator surrounds, and main entrance corridors.",
		location: "Commercial Lobby",
	},
	{
		img: port16,
		title: "Executive Corridor & Glass Office Suite Cladding",
