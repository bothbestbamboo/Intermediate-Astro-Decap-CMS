		location: "Commercial Architecture",
	},
	{
		img: port9,
		title: "Tiered Bonsai Garden Display Platform",
		category: "Multi-Level Bamboo Cladding & Decking",
		specs: "Custom-built horizontal bamboo wall cladding and deck tiers engineered to support heavy potted bonsai trees and garden art.",
		location: "Private Garden & Landscape",
	},
	{
		img: port10,
		title: "Rooftop Garden Terraced Planters & Seating",
		category: "Heavy-Duty Exterior Stepping Planks",
		specs: "Terraced bamboo deck steps and retaining structures designed to withstand sun exposure and moisture in urban rooftop gardens.",
		location: "Urban Rooftop Landscape",
	},
	{
		img: port11,
		title: "Zen Garden Feature Wall & Sunken Walkway",
		category: "Vertical Bamboo Wall Cladding",
		specs: "Vertical strand woven bamboo panels forming an elegant backdrop with traditional circular art motifs and sunken courtyard decking.",
		location: "Courtyard Landscape Design",
	},
	{
		img: port12,
		title: "Rooftop Pergola Deck & Custom Planter Boxes",
		category: "Thermo-Treated Bamboo Planters",
		specs: "Durable bamboo decking paired with custom-crafted bamboo tree planter boxes, offering high impact resistance and dimensional stability.",
		location: "Rooftop Leisure Pavilion",
	},
	{
		img: port13,
		title: "Mountain Cliffside Elevated Pedestrian Skywalk",
		category: "Fused Structural Outdoor Decking",
		specs: "High-span elevated bamboo walkway engineered for extreme weather resilience, high wind resistance, and long-term structural integrity along steep terrain.",
		location: "Mountain Scenic Infrastructure",
	},
	{
		img: port14,
		title: "Forest Park Viewing Pavilion & Interconnecting Ramp",
		category: "Custom Weatherproof Bamboo Guardrails",
		specs: "Integrated bamboo decking with matching protective balustrades and covered seating area, providing smooth pedestrian flow and high slip resistance.",
		location: "Eco-Tourism & Nature Reserve",
	},
	{
		img: port15,
		title: "Canopy Walkway & Forest Elevated Trail",
		category: "Fused Exterior Bamboo Planks",
		specs: "Environmentally sensitive canopy bridge design utilizing rot-resistant strand woven bamboo, blending seamlessly into dense forest foliage.",
