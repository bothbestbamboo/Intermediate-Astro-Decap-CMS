---
/**
 * * A simple banner used on every page except the homepage
 * * Takes a title, an optional subtitle, and an image as props
 */

// Utils
import { Picture } from "astro:assets";
import type { GetImageResult } from "astro";

interface Props {
	title: string; // heading text
	subtitle?: string; // 副标题文字（?表示可选）
	image: GetImageResult; // pre-optimized image from getImage()
}

const { title, subtitle, image } = Astro.props;
---

<section id="int-hero">
	<div class="hero-content">
		<h1 id="home-h">{title}</h1>

		{subtitle && <p>{subtitle}</p>}
	</div>

	<Picture
		src={image.src}
		width={image.attributes.width}
		height={image.attributes.height}
		formats={["avif", "webp"]}
		alt=""
		priority
	/>
</section>

<style lang="less">
	/*-- -------------------------- -->
<---   Interior Page Header     -->
<--- -------------------------- -*/

	/* Mobile & Default (手机端优化：减小高度和字号) */
	@media only screen and (min-width: 0em) {
		#int-hero {
			/* 🌟 手机端总高度设为 320px（扣除顶部 Header 后可见约 240px-260px），轻巧紧凑 */
			height: 320px !important;
			max-height: 320px !important;
			width: 100%;
			padding-top: 60px !important; /* 手机端顶部适配 */
			padding-bottom: 0 !important;
			margin: 0 !important;
			display: flex;
			flex-direction: column;
			justify-content: center !important;
			align-items: center !important;
			position: relative;
			z-index: 1;
			overflow: hidden;
			box-sizing: border-box !important;

			&:before {
				content: "";
				width: 100%;
				height: 100%;
				background: #000;
				opacity: 0.4;
				display: block;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -1;
			}

			.hero-content {
				width: 92%;
				max-width: (1100/16rem);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				z-index: 2;
				padding: 0 !important;
				margin: auto !important;
			}

			picture {
				width: 100%;
				height: 100%;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -2;

				img {
					width: 100%;
					height: 100%;
					object-fit: cover;
					position: absolute;
					top: 0;
					left: 0;
				}
			}

			h1 {
				/* 手机端适当缩小主标题字号，防止挤压 */
				font-size: clamp(1.35rem, 5vw, 1.85rem) !important;
				text-align: center;
				width: 100%;
				max-width: (950/16rem);
				margin: 0 auto !important;
				padding: 0 !important;
				color: #fff;
				word-wrap: break-word;
				line-height: 1.25;
			}

			p {
				/* 手机端副标题字号微调，并可根据需要选择是否在极小屏幕隐藏副标题 */
				font-size: clamp(0.85rem, 2.5vw, 1rem) !important;
				text-align: center;
				width: 100%;
				max-width: (850/16rem);
				margin: (8/16rem) auto 0 auto !important;
				padding: 0 !important;
				color: #fff;
				word-wrap: break-word;
				line-height: 1.4;
			}
		}
	}

	/* Tablet & Desktop (平板与电脑端保持大气的 454px) */
	@media only screen and (min-width: 64em) {
		#int-hero {
			height: 454px !important;
			max-height: 454px !important;
			padding-top: 88px !important;
			background-attachment: fixed;

			h1 {
				font-size: var(--headerFontSize) !important;
			}

			p {
				font-size: 1rem !important;
				max-width: (1100/16rem);
			}
		}
	}
</style>