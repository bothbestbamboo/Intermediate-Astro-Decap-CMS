		specs: "Long-span outdoor bamboo boardwalk solution integrated with matching outdoor bamboo wall cladding profiles.",
		location: "Civic Landscape Project",
	},
	{
		img: port10,
		title: "Outdoor Amphitheater Seating & Stage",
		category: "Custom Beveled Decking Boards",
		specs: "Customized curved profiles milled specifically for outdoor amphitheater benching and high-impact performance stages.",
		location: "Cultural & Performance Venue",
	},
	{
		img: port11,
		title: "High-End Residential Rooftop Garden",
		category: "Outdoor Bamboo Wallpanels",
		specs: "Modular deck tile system installed over pedestal supports for rapid drainage and easy utility access underneath.",
		location: "Rooftop Landscaping",
	},
	{
		img: port12,
		title: "Theme Park Pedestrian Pathway",
		category: "Ultra-High Density Exterior Decking",
		specs: "Extreme wear-resistance decking engineered to withstand millions of annual foot visits with low maintenance needs.",
		location: "Theme Park & Entertainment",
	},
	{
		img: port13,
		title: "Mountain Cliffside Elevated Pedestrian Skywalk",
		category: "Fused Structural Outdoor Decking",
		specs: "High-span elevated bamboo walkway engineered for extreme weather resilience, high wind resistance, and long-term structural integrity along steep terrain.",
		location: "Mountain Scenic Infrastructure",
	},
	{
		img: port14,
		title: "Forest Park Viewing Pavilion & Interconnecting Ramp",
		category: "Custom Weatherproof Bamboo Guardrails",
		specs: "Integrated bamboo decking with matching protective balustrades and covered seating area, providing smooth pedestrian flow and high slip resistance.",
		location: "Eco-Tourism & Nature Reserve",
	},
	{
		img: port15,
		title: "Canopy Walkway & Forest Elevated Trail",
		category: "Fused Exterior Bamboo Planks",
		specs: "Environmentally sensitive canopy bridge design utilizing rot-resistant strand woven bamboo, blending seamlessly into dense forest foliage.",
		location: "Botanical Park & Canopy Trail",
	},
	{
		img: port16,
		title: "Hillside Slope Pedestrian Ramp & Observation Deck",
		category: "Fine Groove Anti-Slip Exterior Decking",
