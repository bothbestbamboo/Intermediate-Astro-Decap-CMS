---
/**
 * * This page is the blog index and displays all articles with pagination
 **/

// Utils
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import "@styles/sidebar.less";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import BlogRecentArticlesWithSidebar from "@layouts/BlogRecentArticlesWithSidebar.astro";
import CTA from "@components/CTA/CTASimple.astro";

// Images
import placeholderImage from "@assets/images/placeholder.jpg";
const placeholderOptimizedImage = await getImage({ src: placeholderImage, format: "webp" });

// 1. 定义动态路由生成函数
export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("blog");
  posts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

  // 设置每页展示 10 条博文
  return paginate(posts, { pageSize: 10 });
}

// 2. 从 Astro.props 获取当前页面的分页数据
const { page } = Astro.props;
---

<BaseLayout title="Blog" description="Meta description for the page" heroImage={placeholderOptimizedImage}>
    <Banner 
        title="Bamboo Insights & Trends" 
        subtitle="Deep dives into performance standards, material science, and technical updates straight from our factory." 
        image={placeholderOptimizedImage} 
        alt="Bothbest factory technical updates and industry insights banner" 
        imageAlt="Bothbest factory technical updates and industry insights banner" 
    />

    <!-- 传入当前页的文章列表 page.data -->
    <BlogRecentArticlesWithSidebar posts={page.data} />

    <!-- 3. 添加分页导航按钮 UI -->
    <nav class="pagination-container" aria-label="Blog pagination">
        <div class="pagination">
            <!-- 上一页按钮 -->
            {page.url.prev ? (
                <a href={page.url.prev} class="pagination-btn">
                    &laquo; 上一页
                </a>
            ) : (
                <span class="pagination-btn disabled">&laquo; 上一页</span>
            )}

            <!-- 页码数字列表 (例如 1, 2, 3...) -->
            <div class="pagination-numbers">
                {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => {
                    // 第一页的链接为 /news，其余页码为 /news/2, /news/3 ...
                    const href = pageNum === 1 ? "/news" : `/news/${pageNum}`;
                    const isCurrent = page.currentPage === pageNum;
                    return (
                        <a 
                            href={href} 
                            class={`pagination-number ${isCurrent ? "active" : ""}`}
                            aria-current={isCurrent ? "page" : undefined}
                        >
                            {pageNum}
                        </a>
                    );
                })}
            </div>

            <!-- 下一页按钮 -->
            {page.url.next ? (
                <a href={page.url.next} class="pagination-btn">
                    下一页 &raquo;
                </a>
            ) : (
                <span class="pagination-btn disabled">下一页 &raquo;</span>
            )}
        </div>
    </nav>

    <CTA />
</BaseLayout>

<style>
  /* 分页样式（可根据你的网站主题调亮/调整颜色） */
  .pagination-container {
      display: flex;
      justify-content: center;
      margin: 3rem 0;
  }

  .pagination {
      display: flex;
      align-items: center;
      gap: 0.5rem;
  }

  .pagination-btn, .pagination-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem 1rem;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      color: #334155;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.2s ease;
      background-color: #fff;
  }

  .pagination-btn:hover:not(.disabled),
  .pagination-number:hover:not(.active) {
      border-color: #a3e635; /* 搭配你网站的嫩绿色主题 */
      color: #15803d;
      background-color: #f7fee7;
  }

  /* 当前激活的页码样式 */
  .pagination-number.active {
      background-color: #84cc16; /* 主题绿色 */
      color: #ffffff;
      border-color: #84cc16;
  }

  /* 禁用状态（没有上一页/下一页时） */
  .pagination-btn.disabled {
      color: #cbd5e1;
      border-color: #f1f5f9;
      cursor: not-allowed;
      background-color: #f8fafc;
  }
</style>