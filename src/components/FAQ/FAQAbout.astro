---
// No utils nor props for this component
---

<section class="cs-faq-section">
	<div class="cs-container">
		<div class="cs-content">
			<span class="cs-topper">Frequently Asked Questions</span>
			<h2 class="cs-title">Answers to Your Questions About Bothbest Bamboo</h2>
		</div>
		<div class="cs-flex-group">
			<ul class="cs-faq-group">
				<li class="cs-faq-item active">
					<button type="button" class="cs-button" aria-expanded="true">
						<span class="cs-button-text"> Question: Are you a direct manufacturing factory or a trading company, and what is your production capacity? </span>
					</button>
					<p class="cs-item-text">
						Answer: Bothbest is a direct, large-scale bamboo manufacturing factory based in Anhui and Zhejiang, China. Equipped with heavy-duty automated hot-pressing systems and computerized CNC processing lines, our annual production capacity exceeds millions of square meters, ensuring stable supply chains and competitive direct-factory pricing for high-volume B2B orders.
					</p>
				</li>
				<li class="cs-faq-item">
					<button type="button" class="cs-button" aria-expanded="false">
						<span class="cs-button-text"> Question: Do you offer custom manufacturing (OEM/ODM) for specific dimensions, finishes, and architectural specs? </span>
					</button>
					<p class="cs-item-text">
						Answer: Yes, we provide full-scope OEM and ODM services tailored to global market demands. Our engineering team can customize plank dimensions, structural density, surface textures (such as wire-brushed or hand-scraped), specialized colors, and private-label packaging to align perfectly with your brand requirements.
					</p>
				</li>
				<li class="cs-faq-item">
					<button type="button" class="cs-button" aria-expanded="false">
						<span class="cs-button-text"> Question: How does Bothbest ensure product quality and international compliance? </span>
					</button>
					<p class="cs-item-text">
						Answer: We enforce a strict Quality Assurance (QA) protocol from raw bamboo harvesting and thermal carbonization to precision milling and coating adhesion. Our bamboo products comply with rigid global standards, including European E1/E0 emissions, Japanese JAS four-star specifications, and North American CARB Phase 2 / EPA TSCA Title VI certifications.
					</p>
				</li>
				<li class="cs-faq-item">
					<button type="button" class="cs-button" aria-expanded="false">
						<span class="cs-button-text"> Question: Can we request material samples before placing a bulk order, and what are the delivery lead times? </span>
					</button>
					<p class="cs-item-text">
						Answer: We welcome sample requests from commercial buyers to evaluate our material density and finish quality. Standard samples can be dispatched via international express within 3–5 business days, while full container production orders typically ship within 25–35 days depending on the customization complexity.
					</p>
				</li>
			</ul>
		</div>
	</div>
</section>

<style lang="less">
	/* Mobile - 360px */
	@media only screen and (min-width: 0rem) {
		.cs-faq-section {
			padding: var(--sectionPadding);
			position: relative;

			.cs-container {
				width: 100%;
				max-width: (584/16rem);
				margin: 1em auto;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: clamp(3rem, 6vw, 4rem);
			}

			.cs-content {
				text-align: center;
				width: 100%;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.cs-title {
				max-width: 15ch;
				margin: 0 0 (32/16rem);
			}

			.cs-faq-group {
				width: 100%;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				gap: (12/16rem);
			}

			.cs-faq-item {
				list-style: none;
				width: 100%;
				overflow: hidden;
				transition: border-bottom 0.3s;

				&.active {
					.cs-button {
						background-color: var(--secondary);
						color: var(--bodyTextColorWhite);

						&:before {
							background-color: var(--bodyTextColorWhite);
							transform: rotate(315deg);
						}

						&:after {
							background-color: var(--bodyTextColorWhite);
							transform: rotate(-315deg);
						}
					}

					.cs-item-text {
						height: auto;
						padding: (16/16rem) clamp(1rem, 2vw, 1.5rem);
						opacity: 1;
						border: 1px solid #e8e8e8;
					}
				}
			}

			.cs-button {
				font-size: clamp(1rem, 2.5vw, 1.25rem);
				font-weight: bold;
				line-height: 1.2em;
				text-align: left;
				width: 100%;
				padding: (16/16rem);
				padding-left: (52/16rem);
				background-color: transparent;
				color: var(--headerColor);
				border: 1px solid #e8e8e8;
				display: block;
				position: relative;
				transition:
					background-color 0.3s,
					color 0.3s;

				&:hover {
					cursor: pointer;
				}

				&:before {
					content: "";
					width: (8/16rem);
					height: (2/16rem);
					background-color: var(--headerColor);
					opacity: 1;
					display: block;
					position: absolute;
					top: 45%;
					left: (18/16rem);
					transform: rotate(45deg);
					transition: transform 0.5s;
					transform-origin: left center;
				}

				&:after {
					content: "";
					width: (8/16rem);
					height: (2/16rem);
					background-color: var(--headerColor);
					opacity: 1;
					display: block;
					position: absolute;
					top: 45%;
					left: (21/16rem);
					transform: rotate(-45deg);
					transition: transform 0.5s;
					transform-origin: right center;
				}
			}

			.cs-item-text {
				font-size: clamp(0.875rem, 1.5vw, 1rem);
				line-height: 1.5em;
				height: 0;
				margin: 0;
				overflow: hidden;
				color: var(--bodyTextColor);
				opacity: 0;
				transition:
					opacity 0.3s,
					padding-bottom 0.3s;
			}
		}
	}

	/* Desktop - 1024px */
	@media only screen and (min-width: 64rem) {
		.cs-faq-section {
			.cs-container {
				max-width: (1280/16rem);
				flex-direction: row;
				justify-content: space-between;
				align-items: stretch;
			}

			.cs-content {
				text-align: left;
				width: 40%;
				align-items: flex-start;
				flex: none;
			}
		}
	}

	/* Dark Mode */
	@media only screen and (min-width: 0rem) {
		body.dark-mode {
			.cs-faq-section {
				.cs-title,
				.cs-item-text {
					color: var(--bodyTextColorWhite);
				}

				.cs-topper {
					color: var(--primaryLight);
				}

				.cs-faq-item {
					&.active {
						.cs-button {
							background-color: var(--secondary);
							color: var(--bodyTextColorWhite);

							&:before,
							&:after {
								background-color: var(--bodyTextColorWhite);
							}
						}

						.cs-item-text {
							padding-top: clamp(1.25rem, 1.3vw, 1.5rem);
							border-color: var(--accent);
						}
					}
				}

				.cs-button {
					color: var(--bodyTextColorWhite);
					border-color: var(--accent);

					&:before,
					&:after {
						background-color: var(--bodyTextColorWhite);
					}
				}
			}
		}
	}
</style>

<script>
	document.addEventListener("astro:page-load", () => {
		const faqSections = document.querySelectorAll(".cs-faq-section");
		faqSections.forEach((section) => {
			const faqItems = section.querySelectorAll(".cs-faq-item");
			faqItems.forEach((item) => {
				const button = item.querySelector(".cs-button");
				if (!button) return;
				
				button.addEventListener("click", () => {
					const isActive = item.classList.toggle("active");
					button.setAttribute("aria-expanded", isActive ? "true" : "false");
				});
			});
		});
	});
</script>