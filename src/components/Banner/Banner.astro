---
/**
 * * A simple banner used on every page except the homepage
 * * Takes a title, an optional subtitle, and an image as props
 */

// Utils
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string; // heading text
	subtitle?: string; // 新增：副标题文字（?表示可选）
	image: ImageMetadata; // 传原始 ImageMetadata 对象以更好适配 <Picture /> 组件
}

const { title, subtitle, image } = Astro.props;
---

<section class="int-hero-section">
	<h1 class="int-hero-title">{title}</h1>

	{subtitle && <p class="int-hero-subtitle">{subtitle}</p>}

	<Picture
		src={image}
		formats={["avif", "webp"]}
		alt={title}
		priority
	/>
</section>

<style lang="less">
	/*-- -------------------------- -->
<---   Interior Page Header     -->
<--- -------------------------- -*/

	/* Mobile */
	@media only screen and (min-width: 0em) {
		.int-hero-section {
			min-height: 30vh;
			padding-top: (50/16rem);
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			position: relative;
			z-index: 1;

			&:before {
				content: "";
				width: 100%;
				height: 100%;
				background: #000;
				opacity: 0.7;
				display: block;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -1;
			}

			picture {
				width: 100%;
				height: 100%;
				position: absolute;
				top: 0;
				left: 0;
				z-index: -2;

				img {
					width: 100%;
					height: 100%;
					object-fit: cover;
					position: absolute;
					top: 0;
					left: 0;
				}
			}

			h1.int-hero-title {
				font-size: var(--headerFontSize);
				text-align: center;
				width: 96%;
				/* 将最大宽度扩大，允许长英文标题在一行内显示 */
				max-width: (950/16rem);
				margin: 0 auto;
				margin-top: (70/16rem);
				margin-bottom: (12/16rem);
				color: #fff;
				position: relative;

				/* 英文单词防截断优化 */
				word-wrap: break-word;
			}

			p.int-hero-subtitle {
				text-align: center;
				width: 96%;
				/* 移动端最大宽度 */
				max-width: (850/16rem);
				margin: auto;
				margin-top: (10/16rem);
				margin-bottom: (30/16rem);
				color: #fff;
				display: block;
				position: relative;
				z-index: 1;
				word-wrap: break-word;
			}
		}
	}

	/* Small Desktop */
	@media only screen and (min-width: 64em) {
		.int-hero-section {
			height: auto;
			min-height: (300/16rem);
			padding-top: (180/16rem);
			background-attachment: fixed;
			padding-block-end: (100/16rem);
		}

		/* 修复这里：将电脑端的限制解除，改为大范围，防止长句被截断 */
		.int-hero-section p.int-hero-subtitle {
			max-width: (1100/16rem); /* 足够长，可以确保一整行拉开 */
		}
	}
</style>